APP_NAME=Laravel
SCHOOL_NAME="name of the school"

# Warn when linking/merging a tutor already tied to more than this many students (default 2 → warn at 3+).
GUARDIAN_MULTI_STUDENT_WARN_THRESHOLD=2
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.est118.test:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Dev local domains: .est118.test (hosts). Prod: .yourdomain.com — never an IP.
SESSION_DOMAIN=.est118.test
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

FRONTEND_URL=http://est118.test:3000
# Comma-separated hosts that use cookie SPA auth (include port if non-default)
SANCTUM_STATEFUL_DOMAINS=est118.test:3000,localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (websockets) — local/LAN use http + port 8080
REVERB_APP_ID=est118-local
REVERB_APP_KEY=est118-local-key
REVERB_APP_SECRET=est118-local-secret
REVERB_HOST=api.est118.test
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_ANNOUNCEMENTS_CHAT_ID=
TELEGRAM_ANNOUNCEMENTS_INVITE_LINK=
# Optional; defaults to "default" (same as php artisan queue:work)
# TELEGRAM_ANNOUNCEMENTS_QUEUE=default

# General Attendance
ATTENDANCE_TIMEZONE=America/Mexico_City
ATTENDANCE_ENTRY_TIME=07:00
ATTENDANCE_TOLERANCE_MINUTES=10
ATTENDANCE_EXIT_EARLIEST=13:30
ATTENDANCE_ENTRY_WINDOW_CLOSES_AT=12:00
